#!/usr/bin/env node
// Rig stand-in for SSH to the provider-created "server" (127.0.0.1). Rig A
// runs each host command with this machine's shell and Docker engine, with
// host paths under /opt/hallvi and /run/lock mapped to SG_RIG_HOST_ROOT.
// Rig B (SG_RIG_HOST_CONTAINER) runs it unchanged as root inside that Linux
// host container (tests/rig/host), whose real paths, systemd and dockerd
// the product uses. Every invocation is logged (command prefix, duration,
// exit) as transport evidence.
"use strict";
const { appendFileSync } = require("node:fs");
const { spawn } = require("node:child_process");
const { join } = require("node:path");

const root = process.env.SG_RIG_HOST_ROOT;
const container = process.env.SG_RIG_HOST_CONTAINER;
if (!root) {
  console.error("SG_RIG_HOST_ROOT is not set");
  process.exit(255);
}
// Rig B with a real sshd: stop emulating SSH and be it. The product's own
// arguments run against the real client — its host-key pinning, its key,
// its control socket, its `-L` forward — and only the destination is
// rewritten to the loopback endpoint the rig published. Anything the product
// does for security it still does here.
const sshPort = process.env.SG_RIG_SSH_PORT;
if (sshPort) {
  const { execFileSync } = require("node:child_process");
  const takesValue = new Set(
    "b c D E e F I i J L l m O o p Q R S W w".split(" "),
  );
  const argv = process.argv.slice(2);
  const out = [];
  let destination = -1;
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (destination < 0 && arg.startsWith("-") && arg.length > 1) {
      const flag = arg.slice(1);
      out.push(arg);
      // `-p 22` becomes the published port; everything else passes through.
      if (takesValue.has(flag)) {
        const value = argv[++i];
        out.push(flag === "p" ? sshPort : value);
      }
      continue;
    }
    if (destination < 0) {
      destination = out.length;
      const at = arg.lastIndexOf("@");
      out.push(at >= 0 ? `${arg.slice(0, at + 1)}127.0.0.1` : "127.0.0.1");
      continue;
    }
    out.push(arg);
  }
  if (destination < 0) out.push("127.0.0.1");
  try {
    const result = execFileSync("/usr/bin/ssh", out, {
      stdio: "inherit",
      encoding: "utf8",
    });
    if (result) process.stdout.write(result);
    process.exit(0);
  } catch (error) {
    process.exit(typeof error.status === "number" ? error.status : 255);
  }
}

const original = process.argv.at(-1) ?? "";
// Only the host's per-deployment paths: a path inside a container, such as
// /opt/hallvi/check.php in a check command, must pass through unchanged.
let command = container
  ? original
  : original
      .replace(
        /\/opt\/hallvi\/(?=[0-9a-f]{8}-[0-9a-f]{4}-)/g,
        `${root}/opt/hallvi/`,
      )
      .replaceAll("/run/lock/", `${root}/run/lock/`);
let note = container ? `host container ${container}` : "";
if (command.includes("hallvi-metadata-guard")) {
  // Cloud metadata firewalling has no equivalent on this machine.
  command = "true";
  note = "metadata guard skipped";
} else if (command.includes("cloud-init status --wait")) {
  command = command.replace(
    /cloud-init status --wait\s*>\s*\/dev\/null\s*&&\s*/,
    "",
  );
  note = `${note ? `${note}; ` : ""}cloud-init wait skipped`;
}
const started = Date.now();
// The recommended host is x86; builds and pulls target it.
const child = container
  ? spawn(
      "docker",
      [
        "exec",
        "-i",
        "-e",
        "DOCKER_DEFAULT_PLATFORM=linux/amd64",
        "-e",
        "SSH_CONNECTION=127.0.0.1 50000 127.0.0.1 22",
        container,
        "sh",
        "-c",
        command,
      ],
      { stdio: "inherit" },
    )
  : spawn("sh", ["-c", command], {
      stdio: "inherit",
      env: {
        ...process.env,
        SSH_CONNECTION: "127.0.0.1 50000 127.0.0.1 22",
        DOCKER_DEFAULT_PLATFORM: "linux/amd64",
      },
    });
child.on("exit", (code, signal) => {
  appendFileSync(
    join(root, "ssh.log"),
    JSON.stringify({
      at: new Date(started).toISOString(),
      ms: Date.now() - started,
      exit: code,
      signal,
      note,
      command: original.slice(0, 600),
    }) + "\n",
  );
  process.exit(code ?? 255);
});
