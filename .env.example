# Optional: enable a separate GitHub login in Settings.
# Copy to .env.local and replace these public identifiers with your GitHub App's.
# See docs/integrations/github.md. Do not add a client secret or private key.
SERVER_GUY_GITHUB_CLIENT_ID=
SERVER_GUY_GITHUB_APP_SLUG=

# Optional metadata-only tracing. Never commit real keys.
# Disabled by default; reply details and Activity work without a Langfuse account.
SERVER_GUY_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Used only for authenticated links from a reply's Technical details to your project.
LANGFUSE_PROJECT_ID=
