# Optional: enable a separate GitHub login in Settings.
# Copy to .env.local and replace these public identifiers with your GitHub App's.
# See docs/integrations/github.md. Do not add a client secret or private key.
SERVER_GUY_GITHUB_CLIENT_ID=
SERVER_GUY_GITHUB_APP_SLUG=

# Local metadata-only files: replies.ndjson events and spans.ndjson OTLP spans.
# Defaults to diagnostics/ beside the database. Each rotates at 1 MiB with
# three archives, including when remote trace export is disabled.
SERVER_GUY_LOG_DIR=

# Optional metadata-only trace export. Never commit real keys.
# No service is required for Chat, Activity or local diagnostics.
SERVER_GUY_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional generic OTLP/HTTP trace endpoint; takes precedence over Langfuse.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=

# Optional Pi account location, shared across preview checkouts by default:
# ~/.config/server-guy/pi. Keep application data in its own controller directory.
# An explicit SERVER_GUY_CONFIG_DIR isolates Pi too unless overridden here.
# SERVER_GUY_PI_CONFIG_DIR=/absolute/path/to/shared-pi-account
