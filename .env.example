# Optional: enable a separate GitHub login in Settings.
# Copy to .env.local and replace these public identifiers with your GitHub App's.
# See docs/integrations/github.md. Do not add a client secret or private key.
SERVER_GUY_GITHUB_CLIENT_ID=
SERVER_GUY_GITHUB_APP_SLUG=

# Local metadata-only logs: defaults to diagnostics/ beside the database.
# Rotates at 1 MiB, retaining three archives. Works with tracing disabled.
SERVER_GUY_LOG_DIR=

# Optional metadata-only trace export. Never commit real keys.
# No service is required for Chat, Activity or local diagnostics.
SERVER_GUY_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional generic OTLP/HTTP trace endpoint; takes precedence over Langfuse.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
