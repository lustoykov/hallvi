{
  "name": "server-guy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:push": "node scripts/prepare-db.mjs && drizzle-kit push --force && node scripts/stamp-db.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/worker.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config tests/application/vitest.config.mjs",
    "test:ui": "vitest --ui --config tests/application/vitest.config.mjs",
    "test:e2e": "playwright test --config tests/browser/playwright.config.ts",
    "test:e2e:smoke": "npm run test:e2e -- --grep @smoke",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "test:dashboard": "node --experimental-strip-types tests/dashboard/server.ts",
    "eval:pi": "node -e \"console.error('The old workflow eval runner is retired. Use the operator storage/execution tests; live deployment evals follow provisioning.'); process.exitCode = 1\"",
    "eval:judge": "vitest run --config tests/evals/judge.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@langfuse/otel": "5.11.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@phosphor-icons/react": "2.1.10",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tar-stream": "3.2.1",
    "tsx": "4.23.13",
    "typebox": "1.3.7",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitest/ui": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "@types/three": "^0.185.4"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
